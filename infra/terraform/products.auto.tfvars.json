{
  "domains": [
    "listings",
    "dealers",
    "leads",
    "pricing"
  ],
  "lf_tags": {
    "domain": [
      "listings",
      "dealers",
      "leads",
      "pricing"
    ],
    "sensitivity": [
      "public",
      "internal",
      "confidential",
      "pii"
    ]
  },
  "tables": {
    "dealers.dealers": {
      "domain": "dealers",
      "name": "dealers",
      "description": "Dealers registered on the marketplace with their subscription tier and contact details. One row per dealer per day (a daily snapshot from the dealer CRM).",
      "owner": "team-dealers",
      "version": 2,
      "partition": "dt",
      "columns": [
        {
          "name": "dealer_id",
          "type": "string",
          "comment": "Id of the dealer",
          "sensitivity": "internal"
        },
        {
          "name": "dealer_name",
          "type": "string",
          "comment": "Trading name",
          "sensitivity": "internal"
        },
        {
          "name": "country",
          "type": "string",
          "comment": "ISO country code",
          "sensitivity": "public"
        },
        {
          "name": "city",
          "type": "string",
          "comment": "City of the main branch",
          "sensitivity": "internal"
        },
        {
          "name": "tier",
          "type": "string",
          "comment": "Subscription tier basic, pro or premium",
          "sensitivity": "internal"
        },
        {
          "name": "contact_email",
          "type": "string",
          "comment": "Email of the dealer's contact person",
          "sensitivity": "pii"
        },
        {
          "name": "contact_phone",
          "type": "string",
          "comment": "Phone of the dealer's contact person",
          "sensitivity": "pii"
        },
        {
          "name": "vat_id",
          "type": "string",
          "comment": "VAT identification number",
          "sensitivity": "confidential"
        },
        {
          "name": "onboarded_on",
          "type": "date",
          "comment": "Date the dealer joined",
          "sensitivity": "internal"
        }
      ]
    },
    "leads.dealer_lead_performance": {
      "domain": "leads",
      "name": "dealer_lead_performance",
      "description": "Leads each dealer received per day, with the dealer's tier and the number of listings it had online, so sales and dealer success can compare lead performance across dealers and tiers.",
      "owner": "team-leads",
      "version": 1,
      "partition": "dt",
      "columns": [
        {
          "name": "dealer_id",
          "type": "string",
          "comment": "Id of the dealer",
          "sensitivity": "internal"
        },
        {
          "name": "country",
          "type": "string",
          "comment": "ISO country code of the dealer",
          "sensitivity": "public"
        },
        {
          "name": "tier",
          "type": "string",
          "comment": "Subscription tier",
          "sensitivity": "internal"
        },
        {
          "name": "leads",
          "type": "bigint",
          "comment": "Leads received that day",
          "sensitivity": "internal"
        },
        {
          "name": "listings_online",
          "type": "bigint",
          "comment": "Listings the dealer had online that day",
          "sensitivity": "internal"
        },
        {
          "name": "leads_per_listing",
          "type": "double",
          "comment": "leads divided by listings_online",
          "sensitivity": "internal"
        }
      ]
    },
    "leads.leads": {
      "domain": "leads",
      "name": "leads",
      "description": "Buyer enquiries sent to a seller about a listing, by email, phone call or chat. One row per lead. Contains the buyer's contact details.",
      "owner": "team-leads",
      "version": 2,
      "partition": "dt",
      "columns": [
        {
          "name": "lead_id",
          "type": "string",
          "comment": "Id of the lead",
          "sensitivity": "internal"
        },
        {
          "name": "listing_id",
          "type": "string",
          "comment": "Listing the buyer asked about",
          "sensitivity": "internal"
        },
        {
          "name": "dealer_id",
          "type": "string",
          "comment": "Dealer who received the lead; empty for private sellers",
          "sensitivity": "internal"
        },
        {
          "name": "channel",
          "type": "string",
          "comment": "email, call or chat",
          "sensitivity": "public"
        },
        {
          "name": "country",
          "type": "string",
          "comment": "ISO country code of the listing",
          "sensitivity": "public"
        },
        {
          "name": "buyer_email",
          "type": "string",
          "comment": "Buyer's email address",
          "sensitivity": "pii"
        },
        {
          "name": "buyer_phone",
          "type": "string",
          "comment": "Buyer's phone number",
          "sensitivity": "pii"
        },
        {
          "name": "created_ts",
          "type": "timestamp",
          "comment": "When the lead was sent (UTC)",
          "sensitivity": "internal"
        }
      ]
    },
    "listings.active_listings_daily": {
      "domain": "listings",
      "name": "active_listings_daily",
      "description": "Stock on the marketplace at the end of each day: number of active listings and median asking price by country and make. Use it for supply and price-level questions.",
      "owner": "team-listings",
      "version": 1,
      "partition": "dt",
      "columns": [
        {
          "name": "country",
          "type": "string",
          "comment": "ISO country code",
          "sensitivity": "public"
        },
        {
          "name": "make",
          "type": "string",
          "comment": "Manufacturer",
          "sensitivity": "public"
        },
        {
          "name": "active_listings",
          "type": "bigint",
          "comment": "Listings online at the end of the day",
          "sensitivity": "public"
        },
        {
          "name": "median_price_eur",
          "type": "double",
          "comment": "Median asking price of active listings",
          "sensitivity": "public"
        }
      ]
    },
    "listings.listing_events": {
      "domain": "listings",
      "name": "listing_events",
      "description": "Every change to a car listing on the marketplace: created, price changed, sold or removed. One row per event. Source-aligned: written as the listing service emits it, cleaned and typed.",
      "owner": "team-listings",
      "version": 3,
      "partition": "dt",
      "columns": [
        {
          "name": "event_id",
          "type": "string",
          "comment": "Unique id of the event",
          "sensitivity": "internal"
        },
        {
          "name": "listing_id",
          "type": "string",
          "comment": "Id of the listing",
          "sensitivity": "internal"
        },
        {
          "name": "dealer_id",
          "type": "string",
          "comment": "Dealer who owns the listing; empty for private sellers",
          "sensitivity": "internal"
        },
        {
          "name": "seller_type",
          "type": "string",
          "comment": "dealer or private",
          "sensitivity": "public"
        },
        {
          "name": "make",
          "type": "string",
          "comment": "Manufacturer, e.g. Volkswagen",
          "sensitivity": "public"
        },
        {
          "name": "model",
          "type": "string",
          "comment": "Model name, e.g. Golf",
          "sensitivity": "public"
        },
        {
          "name": "first_registration_year",
          "type": "int",
          "comment": "Year of first registration",
          "sensitivity": "public"
        },
        {
          "name": "mileage_km",
          "type": "int",
          "comment": "Odometer reading in kilometres",
          "sensitivity": "public"
        },
        {
          "name": "fuel",
          "type": "string",
          "comment": "petrol, diesel, electric, hybrid or lpg",
          "sensitivity": "public"
        },
        {
          "name": "price_eur",
          "type": "double",
          "comment": "Asking price in euros",
          "sensitivity": "public"
        },
        {
          "name": "country",
          "type": "string",
          "comment": "ISO country code of the listing",
          "sensitivity": "public"
        },
        {
          "name": "event_type",
          "type": "string",
          "comment": "created, price_change, sold or removed",
          "sensitivity": "public"
        },
        {
          "name": "event_ts",
          "type": "timestamp",
          "comment": "When the event happened (UTC)",
          "sensitivity": "internal"
        }
      ]
    },
    "pricing.price_ratings": {
      "domain": "pricing",
      "name": "price_ratings",
      "description": "The price rating shown on each listing created that day (great, good, fair or high), from the asking price compared with similar cars: same make, model, registration year band and mileage band.",
      "owner": "team-pricing",
      "version": 1,
      "partition": "dt",
      "columns": [
        {
          "name": "listing_id",
          "type": "string",
          "comment": "Id of the listing",
          "sensitivity": "internal"
        },
        {
          "name": "country",
          "type": "string",
          "comment": "ISO country code",
          "sensitivity": "public"
        },
        {
          "name": "make",
          "type": "string",
          "comment": "Manufacturer",
          "sensitivity": "public"
        },
        {
          "name": "model",
          "type": "string",
          "comment": "Model",
          "sensitivity": "public"
        },
        {
          "name": "price_eur",
          "type": "double",
          "comment": "Asking price",
          "sensitivity": "public"
        },
        {
          "name": "reference_price_eur",
          "type": "double",
          "comment": "Median price of comparable listings",
          "sensitivity": "internal"
        },
        {
          "name": "rating",
          "type": "string",
          "comment": "great, good, fair or high",
          "sensitivity": "public"
        }
      ]
    }
  },
  "principals": {
    "analysts-marketplace": {
